<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Streamora" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorControlActivated">@color/brand</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/soft</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>

    <style name="Theme.Streamora.Player">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Streamora.Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/button_brand</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Streamora.Button.Secondary">
        <item name="android:background">@drawable/button_secondary</item>
    </style>

    <style name="Streamora.PlayerButton" parent="android:Widget.Material.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="Streamora.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
    </style>
</resources>

# ─────────────────────────────────────────────────────────────────────────────
# Streamora configuration
# Copy to `.env` (repo root) and adjust. Every value is optional.
# Relative paths are resolved from the repository root.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8484
# `npm run dev` serves the API here instead of PORT, so it can run next to the
# desktop app (which uses 8484). The Vite dev server on :5173 follows it.
DEV_PORT=8483
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Where Streamora keeps its database, caches and plugin data.
DATA_DIR=./data
# SQLite database file. Defaults to $DATA_DIR/streamora.db
DATABASE_PATH=

# Secret used to sign profile session cookies.
# When empty, a random secret is generated once and stored in $DATA_DIR/.session-secret
SESSION_SECRET=
# Session lifetime in days
SESSION_TTL_DAYS=30

# Comma-separated list of browser origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Extra addresses the Android app should know this server by, comma-separated, such
# as a Tailscale MagicDNS name: http://my-pc.tail1234.ts.net:8484. Home-network and
# Tailscale IP addresses are found automatically.
ADVERTISED_URLS=

# ── Plugins ──────────────────────────────────────────────────────────────────
PLUGINS_DIR=./plugins
# Watch the plugins folder and reload plugins automatically when their files change.
PLUGINS_HOT_RELOAD=true
# Per-call timeout for plugin capability methods (ms)
PLUGIN_CALL_TIMEOUT_MS=30000

# Plugin settings can be seeded from environment variables when a manifest
# setting declares `"env": "<NAME>"`. Values saved in Admin > Plugins win.
# tmdb-metadata → apiKey (v3 API key or v4 read-access token from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# ── Library scanning ─────────────────────────────────────────────────────────
# Full scan of every library when the server starts (unchanged files are only stat'ed).
SCAN_ON_STARTUP=true
# Periodic full scans in minutes (0 = off). File watchers handle changes in between.
SCAN_INTERVAL_MINUTES=360
# Poll for changes instead of native file events. Turn on for network shares
# (SMB/NFS) and Docker bind mounts where events don't arrive.
SCAN_WATCH_POLLING=false
# ffprobe processes run in parallel while scanning (lower for slow NAS disks).
SCAN_PROBE_CONCURRENCY=3

# ── Media engine ─────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Scratch space for HLS segments. Defaults to $DATA_DIR/transcodes
TRANSCODE_DIR=
# H.264 encoder for transcodes: auto | none | nvenc | videotoolbox | vaapi | qsv
# `auto` tries the GPU encoders available on this platform with a test encode
# and falls back to libx264 (software).
HW_ACCEL=auto
VAAPI_DEVICE=/dev/dri/renderD128
# Concurrent video transcodes (remuxes, which only copy video, may use 4x this).
MAX_TRANSCODE_SESSIONS=3
